#!/usr/bin/env bash
#MISE description="Validate Conventional Commits (first line of the commit message)"
set -euo pipefail

file="${1:?usage: mise run commitlint <commit-msg-file>}"
header="$(sed -n '1p' "$file" | tr -d '\r')"

case "$header" in
  Merge\ * | 'fixup!'* | 'squash!'*)
    exit 0
    ;;
esac

if printf '%s\n' "$header" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].{0,71}$'; then
  exit 0
fi

echo "commit message is not Conventional Commits:" >&2
echo "  $header" >&2
echo "expected: type(scope)?: subject" >&2
echo "types: feat fix docs style refactor perf test build ci chore revert" >&2
exit 1
