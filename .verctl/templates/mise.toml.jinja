{%- set path = "examples" -%}
{%- set version = versions["verctl"] -%}
min_version = "2026.7.7"

[settings]
experimental = true
lockfile = true

# This file is served: `.verctl/templates/mise.toml.jinja` renders it onto the
# Version PR commit, which is the commit the tag names, so the tag carries an
# example that installs itself. A verb added after the release you copy is not
# in that tarball yet — pin the release that carries the verb you copied.
[tools]
"github:victor-software-house/verctl" = "{{ version }}"

[task_config]
includes = [
  "git::https://github.com/victor-software-house/verctl.git//tasks/ver?ref=v{{ version }}",
  "mise-tasks",
]
